{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default capability for main and widget windows",
  "windows": ["main", "w-*"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-internal-toggle-devtools",
    "dialog:default"
  ]
}
